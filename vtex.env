# configures NextJS
NEXT_TELEMETRY_DISABLED=true

# configures WebOps
## Enable re-using node_modules from previous runs for faster builds
USE_BUILD_CACHE=true

## Enable Incremental Static Builds (ISB): 
## https://www.faststore.dev/releases/2022/05/19/webops
USE_STALE_CACHE=true

SITE_HOST=www.sualoja.com.br

# Tipo de relação consultado na API de crossselling da VTEX pela section
# "Compre Junto". Valores válidos: showtogether, similars, accessories,
# whosawalsosaw, whosawalsobought, whoboughtalsobought.
VTEX_CROSS_SELLING_RELATION_TYPE=showtogether

# Nome usado como remetente e no assunto dos e-mails do formulário de contato.
CONTACT_FORM_SENDER_NAME=Fale Conosco

# Site key do reCAPTCHA Enterprise usado no formulário de contato. Pública por
# design. Sem ela, o widget não é renderizado.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Variáveis PRIVADAS abaixo NÃO vão aqui — configure como VTEX Secrets:
#   RECAPTCHA_PROJECT_ID, RECAPTCHA_API_KEY (reCAPTCHA Enterprise)
#   SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD (envio do formulário)
#   VTEX_APP_KEY_SKU, VTEX_APP_TOKEN_SKU (medidas físicas do SKU)


