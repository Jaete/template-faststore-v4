{
  "$extends": ["#/$defs/base-component"],
  "$componentKey": "SeoText",
  "$componentTitle": "Texto SEO",
  "type": "object",
  "required": ["title", "description"],
  "properties": {
    "title": {
      "title": "Título",
      "type": "string",
      "default": "Sobre nós"
    },
    "description": {
      "title": "Descrição",
      "type": "string",
      "widget": {
        "ui:widget": "draftjs-rich-text"
      }
    },
    "linkLabel": {
      "title": "Texto do link",
      "type": "string",
      "default": "Ver mais"
    },
    "linkHref": {
      "title": "Link (URL)",
      "description": "Destino do link \"Ver mais\" (ex.: página de dúvidas frequentes)",
      "type": "string",
      "default": "/duvidas-frequentes"
    }
  }
}
