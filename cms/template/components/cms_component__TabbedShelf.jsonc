{
  "$extends": ["#/$defs/base-component"],
  "$componentKey": "TabbedShelf",
  "$componentTitle": "Vitrine com Abas",
  "type": "object",
  "required": ["tabs"],
  "properties": {
    "title": {
      "title": "Título da seção",
      "type": "string",
      "widget": {
        "ui:widget": "draftjs-rich-text"
      },
    },
    "visibleItems": {
      "title": "Itens visíveis por vez",
      "description": "Quantos produtos já aparecem de início na vitrine — define quantas posições os dots/setas percorrem",
      "type": "integer",
      "default": 4,
    },
    "tabs": {
      "title": "Abas",
      "description": "Cada aba exibe uma vitrine de produtos própria",
      "type": "array",
      "items": {
        "type": "object",
        "title": "Aba",
        "required": ["label"],
        "properties": {
          "label": {
            "type": "string",
            "title": "Nome da aba",
          },
          "collectionId": {
            "type": "string",
            "title": "ID da coleção",
            "description": "Para buscar produtos de uma coleção (productClusterIds). Consulte os IDs na página de Coleções",
          },
          "categoryId": {
            "type": "string",
            "title": "ID/slug da categoria",
            "description": "Para buscar produtos de uma categoria de nível 1",
          },
          "bestSellers": {
            "type": "boolean",
            "title": "Mais vendidos?",
            "description": "Ordena os produtos por mais vendidos (orders_desc)",
            "default": false,
          },
          "numberOfItems": {
            "type": "integer",
            "title": "Quantidade de produtos",
            "default": 10,
          },
        },
      },
    },
  },
}
